{
  "roles": {
    "planner": {"model": "deepseek-r1:70b", "num_predict": 6144, "temperature": 0.1, "max_turns": 8},
    "researcher": {"model": "deepseek-r1:70b", "num_predict": 6144, "temperature": 0.2, "max_turns": 8},
    "architect": {"model": "deepseek-r1:70b", "num_predict": 6144, "temperature": 0.1, "max_turns": 8},
    "coder": {"model": "qwen2.5-coder:32b", "num_predict": 4096, "temperature": 0.1, "max_turns": 8},
    "qa": {"model": "qwen2.5-coder:32b", "num_predict": 4096, "temperature": 0.1, "max_turns": 8},
    "reviewer": {"model": "deepseek-r1:70b", "num_predict": 4096, "temperature": 0.0, "max_turns": 8},
    "reflector": {"model": "deepseek-r1:70b", "num_predict": 6144, "temperature": 0.1, "max_turns": 8}
  },
  "ollama": {
    "base_url": "http://127.0.0.1:11434",
    "context_length": 16384,
    "keep_alive": "5m",
    "load_timeout_seconds": 1800,
    "request_timeout_seconds": 3600,
    "dedicated_ollama": true,
    "offload_on_exit": true,
    "transport_retries": 2
  },
  "commands": {
    "unit_tests": {
      "argv": ["{python}", "-m", "unittest", "discover", "-s", "tests", "-v"],
      "timeout_seconds": 120,
      "resume_policy": "rerun"
    },
    "pytest": {
      "argv": ["{python}", "-m", "pytest", "-q"],
      "timeout_seconds": 120,
      "resume_policy": "rerun"
    },
    "compile_all": {
      "argv": ["{python}", "-m", "compileall", "-q", "."],
      "timeout_seconds": 120,
      "resume_policy": "rerun"
    }
  },
  "web": {
    "enabled": true,
    "search_url": "https://html.duckduckgo.com/html/?q={query}",
    "allowed_domains": ["*"],
    "timeout_seconds": 30,
    "max_bytes": 1000000,
    "max_results": 5
  },
  "limits": {
    "max_tasks": 64,
    "max_waves": 128,
    "max_repair_cycles": 2,
    "max_protocol_retries": 2,
    "max_file_bytes": 2000000,
    "max_command_output_bytes": 2000000,
    "max_tool_result_chars": 12000,
    "max_list_entries": 500,
    "safety_reserve_tokens": 512
  }
}
